<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only. Remote services are opt-in and must use an https:// address. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
